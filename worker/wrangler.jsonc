{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "week-on-plate",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SERVICE_NAME": "week-on-plate",
    "APP_VERSION": "0.1.2",
    "BUILD_SHA": "local"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "week-on-plate-db",
      // Placeholder only. Replace locally after `wrangler d1 create`.
      // CI substitutes CLOUDFLARE_D1_DATABASE_ID and does not commit it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
